{
  // Tests and builds, for running by hand. The launches are the SwiftOmniUI
  // extension's "SwiftOmniUI: Debug" and "SwiftOmniUI: Release", which build the same
  // way these do.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test SwiftOmniUI",
      "type": "shell",
      "command": "swift",
      "args": ["test", "--package-path", "${workspaceFolder}"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Test Gallery",
      "type": "shell",
      "command": "swift",
      "args": ["test", "--package-path", "${workspaceFolder}/apps/Gallery"],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}

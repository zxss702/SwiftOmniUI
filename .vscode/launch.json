{
  // Debugging SwiftOmniUI's applications - through the SwiftOmniUI extension,
  // lib/SwiftOmniUI.VSCode (install artifacts/swiftomniui-*.vsix, built by `npm run package`).
  //
  // "SwiftOmniUI: Debug" and "SwiftOmniUI: Release" are the whole of it. The extension's
  // status bar chooses:
  //
  //   the host         Android, WinUI, GTK or Web - and the editor works as it
  //   the application  Gallery, HelloWorld, … - remembered for the workspace
  //   the device       for Android: the phone or emulator it runs on
  //
  // THE PICKER'S ORDER IS `presentation.order`, not the order in this file.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SwiftOmniUI: Debug",
      "type": "swiftomniui",
      "request": "launch",
      "configuration": "debug",
      "presentation": { "group": "0 SwiftOmniUI", "order": 1 }
    },
    {
      "name": "SwiftOmniUI: Release",
      "type": "swiftomniui",
      "request": "launch",
      "configuration": "release",
      "presentation": { "group": "0 SwiftOmniUI", "order": 2 }
    }
  ]
}

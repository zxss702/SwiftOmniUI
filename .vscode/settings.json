{
  // SourceKit resolves imports through SwiftPM manifests, and this repository
  // has one library package at the root and one package per app.
  "swift.searchSubfoldersForPackages": true,
  "swift.autoGenerateLaunchConfigurations": false,

  // NO swift.swiftEnvironmentVariables HERE. The editor's host - which of
  // SWIFTOMNIUI_HOST value SourceKit-LSP starts with - is chosen in the
  // SwiftOmniUI extension's status bar (lib/SwiftOmniUI/SwiftOmniUI.VSCode), which sets it on the
  // extension host's own environment. A value here is laid OVER that and would
  // decide the host whatever is chosen.

  "files.associations": {
    "*.swift": "swift"
  },
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.build": true
  }
}
